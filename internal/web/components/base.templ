package components

templ Base(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<!-- Google Fonts -->
			<link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto:300,300italic,700,700italic"/>

			<!-- Font Awesome -->
			<link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.8.1/css/all.css"/>

			<!-- Application CSS -->
			<link rel="stylesheet" href="/static/css/utilities.css"/>
			<link rel="stylesheet" href="/static/css/base.css"/>
			<link rel="stylesheet" href="/static/css/forms.css"/>
			<link rel="stylesheet" href="/static/css/modals.css"/>
			<link rel="stylesheet" href="/static/css/tables.css"/>
			<link rel="stylesheet" href="/static/css/node-cards.css"/>
			<link rel="stylesheet" href="/static/css/wizard.css"/>
			<link rel="stylesheet" href="/static/css/forwarding.css"/>
			<link rel="stylesheet" href="/static/css/map.css"/>
			<link rel="stylesheet" href="/static/css/users.css"/>

			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="theme-color" content="#94b5eb"/>
			<title>{ title }</title>
		</head>
		<body class="bg-mg-dark text-mg-light font-sans">
			<div class="main container mx-auto px-4">
				{ children... }
			</div>
			<script src="/static/site.js"></script>
		</body>
	</html>
}

// BaseLogin is a simpler base for the login page without the full layout
templ BaseLogin(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<!-- Google Fonts -->
			<link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto:300,300italic,700,700italic"/>

			<!-- Font Awesome -->
			<link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.8.1/css/all.css"/>

			<!-- Application CSS -->
			<link rel="stylesheet" href="/static/css/utilities.css"/>
			<link rel="stylesheet" href="/static/css/base.css"/>
			<link rel="stylesheet" href="/static/css/forms.css"/>

			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="theme-color" content="#94b5eb"/>
			<title>{ title }</title>
		</head>
		<body class="bg-mg-dark text-mg-light font-sans">
			<div class="main container mx-auto px-4">
				{ children... }
			</div>
		</body>
	</html>
}
